{
  "schema": 1,
  "name": "partitioned-disks",
  "purpose": "Whole-disk layouts a sector-preserving repack must reproduce exactly: a bare HFS+ volume with no partition map, and an Apple Partition Map HFSX disk with an explicit free partition carrying a sentinel sector outside every filesystem. Derived signed and encrypted images are refusal controls.",
  "profiles": [
    "hfsplus",
    "hfsx"
  ],
  "requires": {
    "sudo": false
  },
  "image": {
    "create": "hdiutil",
    "size": "32m",
    "layout": "NONE",
    "layoutByProfile": {
      "hfsx": "SPUD"
    },
    "output": "UDBZ",
    "outputByProfile": {
      "hfsx": "raw"
    }
  },
  "passwords": {
    "image": "public-repack-password",
    "wrong": "public-incorrect-password"
  },
  "stages": [
    {
      "name": "final",
      "steps": [
        {
          "tool": {
            "program": "diskutil",
            "args": [
              "partitionDisk",
              "$DEV",
              "2",
              "APM",
              "HFSX",
              "partitioned-disks",
              "24m",
              "Free Space",
              "unused",
              "0"
            ],
            "expect": "0"
          },
          "only": [
            "hfsx"
          ]
        },
        {
          "tool": {
            "program": "diskutil",
            "args": [
              "mount",
              "-mountOptions",
              "owners,noatime",
              "-mountPoint",
              "$MOUNTDIR",
              "$VOLUME"
            ],
            "expect": "0"
          }
        },
