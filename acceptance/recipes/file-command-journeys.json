            "expect": "0",
            "label": "op-15"
          }
        },
        {
          "tool": {
            "program": "cp",
            "args": [
              "$STAGE/empty",
              "$MOUNT/Fixture/Applications/Source.app/Contents/Resources/executable-alias/..namedfork/rsrc"
            ],
            "expect": "0",
            "label": "op-16"
          }
        },
        {
          "tool": {
            "program": "cp",
            "args": [
              "-p",
              "$MOUNT/Fixture/compressed",
              "$MOUNT/Fixture/plain-copy"
            ],
            "expect": "0",
            "label": "op-17"
          }
        },
        {
          "tool": {
            "program": "mv",
            "args": [
              "$MOUNT/Fixture/Applications/Source.app/Contents/New",
              "$MOUNT/Fixture/Applications/Source.app/Contents/Moved"
            ],
            "expect": "0",
            "label": "op-18"
          }
        },
        {
          "tool": {
            "program": "touch",
            "args": [
              "-d",
              "2009-08-07T06:05:04Z",
              "$MOUNT/Fixture/build-alias"
