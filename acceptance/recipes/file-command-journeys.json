            "program": "mv",
            "args": [
              "$MOUNT/Fixture/Applications/Source.app",
              "$MOUNT/Fixture/Applications/Source.app/Contents/cycle"
            ],
            "expect": "1",
            "label": "reject-05"
          }
        }
