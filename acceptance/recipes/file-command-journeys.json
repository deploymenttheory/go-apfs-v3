        },
        {
          "tool": {
            "program": "chown",
            "args": [
              "-R",
              "60001:60002",
              "$MOUNT/Fixture/Applications/Source.app"
            ],
            "expect": "0",
            "sudo": true,
            "label": "op-23"
          }
        },
        {
          "tool": {
            "program": "cp",
            "args": [
