{
  "schema": 1,
  "name": "encrypted-images",
  "purpose": "Password-protected encrcdsa v2 disk images around every filesystem: AES-128 and AES-256, compressed and raw, Unicode and changed passwords, and an independently encrypted APFS volume inside an encrypted image whose credentials stay separate.",
  "profiles": [
    "apfs",
    "apfsx",
    "hfsplus",
    "hfsx"
  ],
  "requires": {
    "sudo": false
  },
  "image": {
    "create": "hdiutil",
    "size": "64m",
    "layout": "GPTSPUD",
    "output": "UDZO",
    "fsargs": {
      "apfs": "-E -S $PASSWORD:volume"
    }
  },
  "passwords": {
    "image": "public-dmg-password",
    "image-unicode": "public-dmg-λ-😀",
    "changed": "public-changed-image-password",
    "wrong": "public-incorrect-password",
    "empty": "",
    "volume": "apfs-v3-public-fixture"
  },
  "stages": [
    {
      "name": "final",
      "steps": [
        {
          "tool": {
            "program": "diskutil",
            "args": [
              "apfs",
              "unlockVolume",
              "$VOLUME",
              "-stdinpassphrase",
              "-nomount"
            ],
            "expect": "0",
            "stdin": [
              "volume"
            ]
          },
          "only": [
            "apfs"
          ]
        },
        {
          "tool": {
            "program": "diskutil",
            "args": [
              "mount",
              "-mountOptions",
              "owners,noatime",
              "-mountPoint",
              "$MOUNTDIR",
              "$VOLUME"
            ],
            "expect": "0"
          },
          "only": [
            "apfs"
          ]
        },
