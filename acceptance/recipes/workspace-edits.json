{
  "schema": 1,
  "name": "workspace-edits",
  "purpose": "The before and after states of content replacement, ordered tree edits and metadata/attribute/fork edits performed natively on one volume, with every rejected operation's errno and the filename length boundaries: portable workspace and session edits must produce the same final trees.",
  "profiles": [
    "apfs",
    "apfsx",
    "hfsplus",
    "hfsx"
  ],
  "requires": {
    "sudo": true
  },
  "image": {
    "create": "hdiutil",
    "size": "64m",
    "layout": "GPTSPUD",
    "output": "UDZO",
    "mountOptions": "owners,noatime"
  },
  "stages": [
