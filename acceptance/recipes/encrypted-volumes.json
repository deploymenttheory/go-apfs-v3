{
  "schema": 1,
  "name": "encrypted-volumes",
  "purpose": "Software-encrypted APFS volumes as Apple creates, converts, re-keys and decrypts them, alongside clone sharing evidence: unlock with the right credential, refuse wrong, empty and stale ones, and read every object including clones, compression and forks.",
  "profiles": [
    "apfs",
    "apfsx"
  ],
  "requires": {
    "sudo": true,
    "versionNotes": {
      "cross-volume-clone": "cp -c between volumes of one container fails with EXDEV on macOS 15 and succeeds on 26 and 27."
    }
  },
  "image": {
    "create": "hdiutil",
    "size": "1536m",
    "layout": "NONE",
    "output": "UDZO",
    "fsargs": {
      "apfs": "-E -S $PASSWORD:primary",
      "apfsx": "-E -S $PASSWORD:primary"
    },
    "volumeName": "Primary"
  },
  "passwords": {
    "primary": "apfs-v3-public-fixture",
    "replacement": "public-lifecycle-replacement-λ",
    "peer": "public-lifecycle-peer",
    "unicode": "public-λ-😀",
    "wrong": "public-incorrect-password",
    "empty": ""
  },
  "stages": [
    {
      "name": "clone-shared",
      "discard": true,
      "steps": [
        {
          "tool": {
            "program": "diskutil",
            "args": [
              "apfs",
              "unlockVolume",
              "$VOLUME:Primary",
              "-stdinpassphrase",
              "-nomount"
            ],
            "expect": "0",
            "stdin": [
              "primary"
            ]
          }
        },
        {
          "tool": {
            "program": "diskutil",
            "args": [
              "mount",
              "-mountOptions",
              "owners,noatime",
              "-mountPoint",
              "$MOUNTDIR:Primary",
              "$VOLUME:Primary"
            ],
            "expect": "0"
          }
        },
        {
          "tool": {
            "program": "mkdir",
            "args": [
              "$MOUNT:Primary/Fixture"
            ],
            "expect": "0",
            "sudo": true
          }
        },
        {
          "tool": {
            "program": "chown",
            "args": [
              "$UID:$GID",
              "$MOUNT:Primary/Fixture"
            ],
            "expect": "0",
            "sudo": true
          }
        },
        {
          "fs": {
            "op": "write",
            "path": "$MOUNT:Primary/Fixture/data",
            "pattern": "sequence",
            "bytes": 262144
          }
        },
        {
          "fs": {
            "op": "append",
            "path": "$MOUNT:Primary/Fixture/data",
            "content": "end"
          }
        },
        {
          "fs": {
            "op": "write",
            "path": "$MOUNT:Primary/Fixture/data/..namedfork/rsrc",
            "pattern": "sequence",
            "bytes": 32768
          }
        },
        {
          "fs": {
            "op": "append",
            "path": "$MOUNT:Primary/Fixture/data/..namedfork/rsrc",
            "content": "fork"
          }
        },
        {
          "fs": {
            "op": "setxattr",
            "path": "$MOUNT:Primary/Fixture/data",
            "name": "org.go-apfs.clone",
            "content": "clone metadata"
          }
        },
        {
          "fs": {
            "op": "chmod",
            "path": "$MOUNT:Primary/Fixture/data",
            "mode": 3565
          }
        },
        {
          "tool": {
            "program": "ln",
            "args": [
              "$MOUNT:Primary/Fixture/data",
              "$MOUNT:Primary/Fixture/alias"
            ],
            "expect": "0"
          }
        },
        {
          "fs": {
            "op": "write",
            "path": "$MOUNT:Primary/Fixture/replacement",
            "content": "replacement before clone\n"
          }
        },
        {
          "tool": {
            "program": "ln",
            "args": [
              "$MOUNT:Primary/Fixture/replacement",
              "$MOUNT:Primary/Fixture/replacement-alias"
            ],
            "expect": "0"
          }
        },
        {
          "tool": {
            "program": "cp",
            "args": [
              "-c",
              "$MOUNT:Primary/Fixture/data",
              "$MOUNT:Primary/Fixture/clone"
            ],
            "expect": "0"
          }
        },
        {
          "tool": {
            "program": "cp",
            "args": [
              "-p",
              "$MOUNT:Primary/Fixture/data",
              "$MOUNT:Primary/Fixture/ordinary-copy"
            ],
            "expect": "0"
          }
        },
        {
          "tool": {
            "program": "cp",
            "args": [
              "-c",
              "$MOUNT:Primary/Fixture/data",
              "$MOUNT:Primary/Fixture/replacement"
            ],
            "expect": "0"
          }
        },
        {
          "fs": {
            "op": "write",
            "path": "$MOUNT:Primary/Fixture/sparse",
            "content": "start"
          }
        },
        {
          "fs": {
            "op": "pwrite",
            "path": "$MOUNT:Primary/Fixture/sparse",
            "offset": 2097159,
            "content": "end"
          }
        },
        {
          "fs": {
            "op": "write",
            "path": "$MOUNT:Primary/Fixture/plain-input",
            "pattern": "sequence",
            "label": "Native compressed filesystem evidence.\nNative compressed filesystem evidence.\nNative compressed filesystem evidence.\nNative compressed filesystem evidence.\nNative compressed filesystem evidence.\nNative compressed filesystem evidence.\nNative compressed filesystem evidence.\nNative compressed filesystem evidence.\nNative compressed filesystem evidence.\nNative compressed filesystem evidence.\nNative compressed filesystem evidence.\nNative compressed filesystem evidence.\nNative compressed filesystem evidence.\nNative compressed filesystem evidence.\nNative compressed filesystem evidence.\nNative compressed filesystem evidence.\nNative compressed filesystem evidence.",
            "bytes": 65553
          }
        },
        {
          "tool": {
            "program": "ditto",
            "args": [
              "--hfsCompression",
              "--noclone",
              "$MOUNT:Primary/Fixture/plain-input",
              "$MOUNT:Primary/Fixture/compressed"
            ],
            "expect": "0"
          }
        },
        {
          "fs": {
            "op": "unlink",
            "path": "$MOUNT:Primary/Fixture/plain-input"
          }
        },
        {
          "fs": {
            "op": "mkdir",
            "path": "$MOUNT:Primary/Fixture/Example.app"
          }
        },
        {
          "fs": {
            "op": "mkdir",
            "path": "$MOUNT:Primary/Fixture/Example.app/Contents"
          }
        },
        {
          "fs": {
            "op": "mkdir",
            "path": "$MOUNT:Primary/Fixture/Example.app/Contents/MacOS"
          }
        },
        {
          "fs": {
            "op": "mkdir",
            "path": "$MOUNT:Primary/Fixture/Example.app/Contents/Resources"
          }
        },
        {
          "fs": {
            "op": "write",
            "path": "$MOUNT:Primary/Fixture/Example.app/Contents/Resources/message.txt",
            "content": "Signed resource preserved by image construction.\n"
          }
        },
        {
          "fs": {
            "op": "write",
            "path": "$MOUNT:Primary/Fixture/Example.app/Contents/Info.plist",
            "content": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\"><dict><key>CFBundleIdentifier</key><string>org.go-apfs.acceptance</string><key>CFBundleExecutable</key><string>Example</string><key>CFBundleName</key><string>Example</string><key>CFBundlePackageType</key><string>APPL</string><key>CFBundleVersion</key><string>1</string></dict></plist>\n"
          }
        },
        {
          "host": {
            "path": "example.c",
            "pattern": "text",
            "content": "int main(void) { return 0; }\n"
          }
        },
        {
          "tool": {
            "program": "xcrun",
            "args": [
              "clang",
              "-arch",
              "arm64",
              "-arch",
              "x86_64",
              "-mmacosx-version-min=11.0",
              "$STAGE/example.c",
              "-o",
              "$MOUNT:Primary/Fixture/Example.app/Contents/MacOS/Example"
            ],
            "expect": "0",
            "timeoutSeconds": 300
          }
        },
        {
          "tool": {
            "program": "codesign",
            "args": [
              "--force",
              "--sign",
              "-",
              "--timestamp=none",
              "$MOUNT:Primary/Fixture/Example.app"
            ],
            "expect": "0"
          }
        },
        {
          "tool": {
            "program": "codesign",
            "args": [
              "--verify",
              "--deep",
              "--strict",
              "$MOUNT:Primary/Fixture/Example.app"
            ],
            "expect": "0"
          }
        },
        {
          "tool": {
            "program": "diskutil",
            "args": [
              "apfs",
              "addVolume",
              "$CONTAINER",
              "APFS",
              "Peer",
              "-nomount"
            ],
            "expect": "0"
          }
        },
        {
          "tool": {
            "program": "diskutil",
            "args": [
              "mount",
              "-mountOptions",
              "owners,noatime",
              "-mountPoint",
              "$MOUNTDIR:Peer",
              "$VOLUME:Peer"
            ],
            "expect": "0"
          }
        },
        {
          "tool": {
            "program": "mkdir",
            "args": [
              "$MOUNT:Peer/Fixture"
            ],
            "expect": "0",
            "sudo": true
          }
        },
        {
          "tool": {
