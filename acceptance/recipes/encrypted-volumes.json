        },
        {
          "tool": {
            "program": "cp",
            "args": [
              "-c",
              "$MOUNT:Primary/Fixture/data",
              "$MOUNT:Peer/Fixture/data"
            ],
            "expect": "record"
          },
          "note": "Cross-volume clone: EXDEV on macOS 15, success on 26 and 27; the outcome is the observation"
        }
