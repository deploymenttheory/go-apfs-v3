{
  "schema": 1,
  "name": "snapshot-history",
  "purpose": "Retained APFS snapshots as Apple's asr creates them, with changes between each state, a deleted snapshot, and a probe of the snapshot create/rename/revert API whose refusal or success is recorded (issue #74).",
  "profiles": [
    "apfs",
    "apfsx"
  ],
  "requires": {
    "sudo": true,
    "entitlements": [
      "com.apple.developer.vfs.snapshot"
    ],
    "helpers": [
      "apfs-snapshot"
    ],
    "versionNotes": {
      "fs_snapshot_list": "macOS 15 returns ENOENT while asr is running; the observer retries only ENOENT within its deadline and records the retry count.",
      "snapshot-api": "The entitled helper may be killed at launch or refused with EPERM; both are recorded outcomes, not failures."
    }
  },
  "image": {
    "create": "hdiutil",
    "size": "128m",
    "layout": "GPTSPUD",
    "output": "UDZO",
    "mountOptions": "owners",
    "volumeName": "v3-snapshots"
  },
  "passwords": {
    "image": "public-snapshot-image-password",
    "wrong": "public-incorrect-password"
  },
