{
  "schema": 1,
  "name": "compressed-files",
  "purpose": "Every decmpfs storage form macOS reads (types 1, 3, 4, 7 to 16; attribute and resource storage; stored blocks; partial last block; zlib with and without Adler-32; descriptor gaps; inactive and malformed controls) plus uncompressed inputs for the compression writer.",
  "profiles": [
    "apfs",
    "apfsx",
    "hfsplus",
    "hfsx"
  ],
  "requires": {
    "sudo": false,
    "versionNotes": {
      "lz4": "Types 15 and 16 have no kernel registration before macOS 27; kernelRead records EIO there and ok on 27 (known-drift.json).",
      "lzbitmap": "Types 13 and 14 have no Apple CLI producer; the committed payloads came from libcompression on macOS 27.0.1 and are installed unchanged on every producer."
    }
  },
  "image": {
    "create": "hdiutil",
    "size": "64m",
    "layout": "GPTSPUD",
    "output": "UDZO",
    "mountOptions": "owners,noatime"
  },
