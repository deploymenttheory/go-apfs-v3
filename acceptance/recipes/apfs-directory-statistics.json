{
  "schema": 1,
  "name": "apfs-directory-statistics",
  "purpose": "Directory statistics (apfs.util -M) maintained by Apple through 35 ordered operations on tracked and untracked trees, with every intermediate state retained: the editor must keep counts, sizes, origins and generations in step.",
  "profiles": [
    "apfs",
    "apfsx"
  ],
  "requires": {
    "sudo": true
  },
  "image": {
    "create": "hdiutil",
    "size": "128m",
    "layout": "NONE",
    "output": "raw",
    "volumeName": "Primary",
    "mountOptions": "owners,noatime"
  },
  "stages": [
    {
      "name": "source",
      "steps": [
        {
          "tool": {
            "program": "mkdir",
            "args": [
              "$MOUNT/Fixture"
            ],
            "expect": "0",
            "sudo": true
          }
        },
        {
          "tool": {
            "program": "chown",
            "args": [
              "$UID:$GID",
              "$MOUNT/Fixture"
            ],
            "expect": "0",
            "sudo": true
          }
        },
        {
          "tool": {
            "program": "apfs.util",
            "args": [
              "-M",
              "$MOUNT/Fixture"
            ],
            "expect": "0",
            "sudo": true
          },
          "note": "enable directory statistics while empty"
        },
        {
          "fs": {
            "op": "write",
            "path": "$MOUNT:Primary/Fixture/data",
            "content": "Original linked contents\n"
          }
        },
        {
          "tool": {
            "program": "ln",
            "args": [
              "$MOUNT:Primary/Fixture/data",
              "$MOUNT:Primary/Fixture/alias"
            ],
            "expect": "0"
          }
        },
        {
          "fs": {
            "op": "symlink",
            "path": "$MOUNT:Primary/Fixture/symlink",
            "target": "data"
          }
        },
        {
          "fs": {
            "op": "write",
            "path": "$MOUNT:Primary/Fixture/data/..namedfork/rsrc",
            "content": "Independent resource fork\u0000ÿ"
          }
        },
        {
          "fs": {
            "op": "setxattr",
            "path": "$MOUNT:Primary/Fixture/data",
            "name": "org.go-apfs.retained",
            "content": "Opaque retained metadata\u0000ÿ"
          }
        },
        {
          "fs": {
            "op": "write",
            "path": "$MOUNT:Primary/Fixture/mode",
            "content": "mode file\n"
          }
        },
        {
          "fs": {
            "op": "chmod",
            "path": "$MOUNT:Primary/Fixture/mode",
            "mode": 420
          }
        },
        {
          "fs": {
            "op": "mkdir",
            "path": "$MOUNT:Primary/Fixture/Example.app/Contents/MacOS"
          }
        },
        {
          "fs": {
            "op": "mkdir",
            "path": "$MOUNT:Primary/Fixture/Example.app/Contents/Resources"
          }
        },
        {
          "fs": {
            "op": "write",
            "path": "$MOUNT:Primary/Fixture/Example.app/Contents/Resources/message.txt",
            "content": "Signed resource preserved by image construction.\n"
          }
        },
        {
          "fs": {
            "op": "write",
            "path": "$MOUNT:Primary/Fixture/Example.app/Contents/Info.plist",
            "content": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!DOCTYPE plist PUBLIC \"-//Apple//DTD PLIST 1.0//EN\" \"http://www.apple.com/DTDs/PropertyList-1.0.dtd\">\n<plist version=\"1.0\"><dict><key>CFBundleIdentifier</key><string>org.go-apfs.acceptance</string><key>CFBundleExecutable</key><string>Example</string><key>CFBundleName</key><string>Example</string><key>CFBundlePackageType</key><string>APPL</string><key>CFBundleVersion</key><string>1</string></dict></plist>\n"
          }
        },
        {
          "host": {
            "path": "example.c",
            "pattern": "text",
            "content": "int main(void) { return 0; }\n"
          }
        },
        {
          "tool": {
            "program": "xcrun",
            "args": [
              "clang",
              "-arch",
              "arm64",
              "-arch",
              "x86_64",
              "-mmacosx-version-min=11.0",
              "$STAGE/example.c",
              "-o",
              "$MOUNT:Primary/Fixture/Example.app/Contents/MacOS/Example"
            ],
            "expect": "0",
            "timeoutSeconds": 300
          }
        },
        {
          "tool": {
            "program": "codesign",
            "args": [
              "--force",
              "--sign",
              "-",
              "--timestamp=none",
              "$MOUNT:Primary/Fixture/Example.app"
            ],
            "expect": "0"
          }
        },
        {
          "tool": {
            "program": "codesign",
            "args": [
              "--verify",
              "--deep",
              "--strict",
              "$MOUNT:Primary/Fixture/Example.app"
            ],
            "expect": "0"
          }
        },
        {
          "fs": {
            "op": "mkdir",
            "path": "$MOUNT/Fixture/nested-origin"
          }
        },
        {
          "tool": {
            "program": "apfs.util",
            "args": [
              "-M",
              "$MOUNT/Fixture/nested-origin"
            ],
            "expect": "0",
            "sudo": true
          }
        },
        {
          "fs": {
            "op": "mkdir",
            "path": "$MOUNT/Fixture/nested-origin/child"
          }
        },
        {
          "fs": {
            "op": "write",
            "path": "$MOUNT/Fixture/nested-origin/child/data",
            "content": "Nested statistics contents\n"
          }
        },
        {
          "tool": {
            "program": "ln",
            "args": [
              "$MOUNT/Fixture/data",
              "$MOUNT/Fixture/nested-origin/cross-directory-alias"
            ],
            "expect": "0"
          }
        },
        {
          "tool": {
            "program": "mkdir",
            "args": [
              "$MOUNT/Untracked"
            ],
            "expect": "0",
            "sudo": true
          }
        },
        {
          "tool": {
            "program": "chown",
            "args": [
              "$UID:$GID",
              "$MOUNT/Untracked"
            ],
            "expect": "0",
            "sudo": true
          }
        },
        {
          "fs": {
            "op": "mkdir",
            "path": "$MOUNT/Untracked/untracked-branch"
          }
        },
        {
          "fs": {
            "op": "write",
            "path": "$MOUNT/Untracked/untracked-branch/data",
            "pattern": "zeros",
            "bytes": 8193
          }
        }
      ],
      "observe": {
        "statistics": [
          "Fixture",
          "Fixture/nested-origin",
          "Fixture/nested-origin/child",
          "Fixture/Example.app",
          "Fixture/Example.app/Contents",
          "Fixture/Example.app/Contents/MacOS",
          "Fixture/Example.app/Contents/Resources"
        ],
