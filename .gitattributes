# .gitattributes snippet to force users to use same line endings for project.
# 
# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched.
* text=auto

*.json text eol=lf

# Native hashes bind exact original bytes, including scripts and plist output.
acceptance/testdata/native/** -text
acceptance/testdata/files/** -text
acceptance/testdata/semantics/** -text
acceptance/testdata/compression/** -text
acceptance/testdata/encryption/** -text
acceptance/testdata/encrypted-dmg/** -text

# Review the pinned inputs and generator for these reproducible tables.
internal/names/*_tables.go linguist-generated=true
